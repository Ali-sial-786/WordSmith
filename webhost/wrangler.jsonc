// The browser version of Wordsmith: a Worker with no code that serves the
// Flutter web build (app/build/web) at https://play.wordsmith-forge.workers.dev.
// The API is a separate Worker (server/, wordsmith-api).
//
// Build the app first (cd app && flutter build web --release --no-web-resources-cdn),
// then: npx wrangler@4.151.1 deploy   (from this folder).
// .github/workflows/deploy-web.yml does both. Caching headers live in
// app/web/_headers; files left out of the upload in app/web/.assetsignore.
{
  "name": "play",
  // Same as server/wrangler.jsonc.
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../app/build/web",
    // The game routes with #/..., so every page is index.html; a missing
    // file is a plain 404 (not the page, which Dart would read as data).
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": false
}
