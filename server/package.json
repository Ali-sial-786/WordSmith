{
  "name": "wordsmith-api",
  "version": "0.1.0",
  "private": true,
  "description": "Wordsmith API: Cloudflare Worker + Durable Objects + D1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply wordsmith --local",
    "db:campaign": "node scripts/build-campaign-sql.mjs",
    "db:seed:local": "node scripts/build-campaign-sql.mjs && wrangler d1 execute wordsmith --local --file data/campaign.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
