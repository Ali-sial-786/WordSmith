{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordsmith-api",
  "main": "src/index.ts",
  // Must not be newer than the workerd bundled with the installed wrangler.
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Served by GET /v1/version (docs/TECH.md §13). Bump on each app release.
    "LATEST_VERSION": "0.1.0",
    "MIN_SUPPORTED_VERSION": "0.1.0",
    // Firebase ID tokens must have aud = this and
    // iss = https://securetoken.google.com/<this> (docs/TECH.md §3). Not a secret.
    "FIREBASE_PROJECT_ID": "wordsmith-8f550"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordsmith",
      // PLACEHOLDER. Local dev and tests don't need a real ID. When the real
      // database is created (`npx wrangler d1 create wordsmith`), paste the
      // database_id it prints here before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // One global instance (idFromName("global")): presence, invites, open rooms.
      { "name": "HUB", "class_name": "HubDO" },
      // One per room code (idFromName(code)): lobby, referee, timers.
      { "name": "ROOM", "class_name": "RoomDO" }
    ]
  },
  // Durable Object class migrations. Append new entries; never edit old ones.
  // SQLite-backed classes are the only kind the Workers Free plan allows.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HubDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDO"] }
  ]
}
